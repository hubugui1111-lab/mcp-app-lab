{
  "name": "mcp-app-lab",
  "version": "0.1.0",
  "description": "A focused MCP Apps host, trace recorder, conformance lab, and visual regression harness.",
  "type": "module",
  "license": "MIT",
  "author": "hubugui1111-lab",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hubugui1111-lab/mcp-app-lab.git"
  },
  "homepage": "https://github.com/hubugui1111-lab/mcp-app-lab#readme",
  "bugs": {
    "url": "https://github.com/hubugui1111-lab/mcp-app-lab/issues"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "model-context-protocol",
    "developer-tools",
    "conformance",
    "playwright"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "mcp-app-lab": "./dist/node/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    }
  },
  "files": [
    "assets",
    "dist",
    "docs",
    "examples",
    "fixtures",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "audit:prod": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "build": "npm run build:web && npm run build:node",
    "build:web": "vite build",
    "build:node": "tsup src/node/cli.ts src/node/index.ts --format esm --dts --clean --out-dir dist/node",
    "dev": "tsx src/node/cli.ts dev",
    "predemo": "npm run build:web",
    "demo": "tsx src/node/cli.ts dev --config examples/good.config.json",
    "demo:bad": "npm run build:web && tsx src/node/cli.ts dev --config fixtures/wrong-mime.json",
    "demo:assets": "node scripts/sync-demo-assets.mjs",
    "predemo:e2e": "npm run build:web",
    "demo:e2e": "tsx src/node/cli.ts dev --config examples/good.config.json --port 4173 --sandbox-port 4174",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/e2e/**",
    "test:unit": "vitest run tests/unit tests/ui",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage --exclude tests/e2e/**",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:fixtures": "npm run build && node scripts/verify-fixtures.mjs",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:coverage && npm run build && node scripts/verify-fixtures.mjs && node scripts/package-smoke.mjs && npm run audit:prod",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "commander": "15.0.0",
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
